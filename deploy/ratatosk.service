# Install as a user service (systemd expands %h to your home folder; the app lives in ~/ratatosk):
#   mkdir -p ~/.config/systemd/user && cp deploy/ratatosk.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now ratatosk
#   loginctl enable-linger "$USER"     # keeps it running without a desktop login
[Unit]
Description=Ratatosk GPU traffic control
After=network-online.target

[Service]
WorkingDirectory=%h/ratatosk
ExecStart=%h/ratatosk/venv/bin/python -m ratatosk --config %h/ratatosk/data/settings.json
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
